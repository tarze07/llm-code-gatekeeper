<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Pakowany jako dotnet tool (PLAN-G2.md §2 "Dystrybucja") — instalowany
         osobno w ocenianym repo, tak jak npm i -g typescript/eslint w ts-packu,
         nie jako zależność pip pack'a gatekeeper_csharp. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gatekeeper-cs-helper</ToolCommandName>
    <PackageId>gatekeeper-cs-helper</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
